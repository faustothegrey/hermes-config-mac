# Never commit plaintext secrets
.env
auth.json
google_token.json
google_client_secret.json
gateway_state.json
pairing
state.db
*.pem
*.key
*.key.plain
*.tar.gz

# Runtime junk
*.tmp
*.lock
*.pid
*.log
__pycache__/
*.pyc
.DS_Store

# Installed executables are not config
profiles/*/bin/

# Secrets are LOCAL-ONLY (2026-08-19): the encrypted bundle is regenerated
# nightly with a fresh random AES key, so every copy is byte-different and
# git can't delta it — it bloated .git to 13GB. Keep secrets on disk for
# local restore, but NEVER version/push them.
secrets/
