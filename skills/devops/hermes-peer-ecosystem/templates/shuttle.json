{
  "_comments": [
    "SSH shortcuts for the Hermes peer network. Each entry runs 'ssh <peer>' and",
    "resolves hostname/user/identity from ~/.ssh/config (managed by sshtmux).",
    "Valid terminals: 'Terminal.app' or 'iTerm'."
  ],
  "editor": "default",
  "launch_at_login": false,
  "terminal": "Terminal.app",
  "iTerm_version": "nightly",
  "default_theme": "Homebrew",
  "open_in": "tab",
  "show_ssh_config_hosts": false,
  "ssh_config_ignore_hosts": [],
  "ssh_config_ignore_keywords": [],
