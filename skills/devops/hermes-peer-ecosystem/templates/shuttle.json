        { "name": "peer84", "cmd": "ssh peer84" },
        { "name": "peer105", "cmd": "ssh peer105" },
        { "name": "peer106", "cmd": "ssh peer106" },
        { "name": "peer128", "cmd": "ssh peer128" },
        { "name": "peer136", "cmd": "ssh peer136" },
        { "name": "peer141", "cmd": "ssh peer141" }
      ]
    }
  ]
